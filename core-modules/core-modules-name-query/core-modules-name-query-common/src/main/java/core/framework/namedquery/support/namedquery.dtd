<?xml version="1.0" encoding="UTF-8" ?>

<!ELEMENT named-queries (sql* | mongo* | fragment*)+>
<!ATTLIST named-queries
        namespace CDATA #REQUIRED
        >

<!ELEMENT fragment (#PCDATA | include | where | foreach | choose | if | bind)*>
<!ATTLIST fragment
        id CDATA #REQUIRED
        >

<!ELEMENT sql (#PCDATA | include | foreach | choose | if | bind | where)*>
<!ATTLIST sql
        id CDATA #REQUIRED
        result-class CDATA>

<!ELEMENT mongo (#PCDATA | include | foreach | choose | if | bind | filter)*>
<!ATTLIST mongo
        id CDATA #REQUIRED
        result-class CDATA>

<!ELEMENT where (#PCDATA | include | where | foreach | choose | if | bind)*>
<!ELEMENT filter (#PCDATA | include | foreach | choose | if | bind)*>

<!ELEMENT bind EMPTY>
<!ATTLIST bind
        name CDATA #REQUIRED
        value CDATA #REQUIRED
        >

<!ELEMENT include (#PCDATA)*>
<!ATTLIST include ref-id CDATA #REQUIRED>

<!ELEMENT foreach (#PCDATA)*>
<!ATTLIST foreach
        collection CDATA #REQUIRED
        open CDATA #IMPLIED
        close CDATA #IMPLIED
        separator CDATA #IMPLIED
        >

<!ELEMENT choose (when* , otherwise?)>
<!ELEMENT when (#PCDATA | include | where | foreach | choose | if | bind)*>
<!ATTLIST when test CDATA #REQUIRED>
<!ELEMENT otherwise (#PCDATA | include | where | foreach | choose | if | bind)*>

<!ELEMENT if (#PCDATA | include | where | foreach | choose | if | bind)*>
<!ATTLIST if test CDATA #REQUIRED>
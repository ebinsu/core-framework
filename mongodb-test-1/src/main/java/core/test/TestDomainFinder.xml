<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="http://java.sun.com/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_2_0.xsd"
        version="2.0">

    <named-query name="TestDomainFinder.selectById">
        <query>
            FROM TestDomain e WHERE e.id = ?1
        </query>
    </named-query>

    <named-query name="TestDomainFinder.count1">
        <query>
            SELECT COUNT(e.id) FROM TestDomain e
        </query>
    </named-query>

    <named-native-query name="TestDomainFinder.selectByIdV2"
                        result-class="core.test.TestDomain">
        <query>
            db.test.find({"_id":"648038ABD3A2183633E04305"})
        </query>
    </named-native-query>

    <named-native-query name="TestDomainFinder.count2">
        <query>
            db.test.find({}).count()
        </query>
    </named-native-query>

</entity-mappings>
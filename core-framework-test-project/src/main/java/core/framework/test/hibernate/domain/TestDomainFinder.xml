<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="http://java.sun.com/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/persistence/orm http://java.sun.com/xml/ns/persistence/orm_2_0.xsd"
        version="2.0">

    <named-query name="TestDomainFinder.selectByName">
        <query>
            FROM TestDomain e WHERE e.name = ?1
        </query>
    </named-query>

    <named-native-query name="TestDomainFinder.selectById" result-class="core.framework.test.hibernate.domain.TestDomain">
        <query>
            select * from test where id = ?1
        </query>
    </named-native-query>

</entity-mappings>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE named-queries SYSTEM "namedquery.dtd">

<named-queries namespace="TestDomain">
    <sql id="get" result-class="java.util.HashMap">
        SELECT * FROM test
        <where>
            <if test="id!=null">
                and id = :id
            </if>
        </where>
    </sql>
    <sql id="getName" result-class="java.util.HashMap">
        SELECT name as "name",test_name as "testName",voname as "voname" ,
        double_num as "doubleNum", float_num as "floatNum",
        long_num as "longNum", big_decimal_num as "bigDecimalNum"

        FROM test
        <where>
            <if test="id!=null">
                and id = :id
            </if>
        </where>
    </sql>
</named-queries>